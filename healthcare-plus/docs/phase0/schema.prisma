// ============================================================
// healthcare+ — Full Design-Reference Prisma Schema
// Location: docs/phase0/schema.prisma (DESIGN ARTIFACT ONLY)
// This is NOT the running schema — see backend/prisma/schema.prisma
// for the Phase 1 foundation subset.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  RECEPTIONIST
  PHARMACIST
  LAB_STAFF
  AMBULANCE_DRIVER
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum PharmacyOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PACKED
  READY
  COMPLETED
  CANCELLED
}

enum LabRequestStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  REPORT_READY
  REJECTED
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EmergencyStatus {
  PENDING
  DISPATCHED
  EN_ROUTE
  ARRIVED
  COMPLETED
  ESCALATED_TO_108
}

enum CrowdLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

// ─────────────────────────────────────────────
// CORE USER & ROLE-PROFILE MODELS
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  fullName        String
  role            Role
  isEmailVerified Boolean   @default(false)
  googleId        String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Role profiles (only one will be set based on role)
  patient         Patient?
  doctor          Doctor?
  hospitalAdmin   HospitalAdmin?
  receptionist    Receptionist?
  pharmacist      Pharmacist?
  labStaff        LabStaff?
  ambulanceDriver AmbulanceDriver?

  notifications   Notification[]
  auditLogs       AuditLog[]
}

model Patient {
  id                    String    @id @default(cuid())
  userId                String    @unique
  bloodGroup            String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  passport          HealthcarePassport?
  appointments      Appointment[]
  pharmacyOrders    PharmacyOrder[]
  labRequests       LabRequest[]
  bills             Bill[]
  payments          Payment[]
  emergencyRequests EmergencyRequest[]
  medicineReminders MedicineReminder[]

  @@index([userId])
}

model Doctor {
  id              String    @id @default(cuid())
  userId          String    @unique
  hospitalId      String
  departmentId    String
  specialization  String
  experienceYears Int
  consultationFee Decimal
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital        Hospital            @relation(fields: [hospitalId], references: [id])
  department      Department          @relation(fields: [departmentId], references: [id])
  availability    DoctorAvailability[]
  appointments    Appointment[]
  consultations   Consultation[]
  consentGrants   PassportConsent[]   @relation("DoctorConsentGrants")

  @@index([userId])
  @@index([hospitalId])
  @@index([departmentId])
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([userId])
  @@index([hospitalId])
}

model Receptionist {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([userId])
  @@index([hospitalId])
}

model Pharmacist {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([userId])
  @@index([hospitalId])
}

model LabStaff {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  labReports LabReport[]

  @@index([userId])
  @@index([hospitalId])
}

model AmbulanceDriver {
  id          String    @id @default(cuid())
  userId      String    @unique
  hospitalId  String
  ambulanceId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital    Hospital   @relation(fields: [hospitalId], references: [id])
  ambulance   Ambulance? @relation(fields: [ambulanceId], references: [id])

  @@index([userId])
  @@index([hospitalId])
  @@index([ambulanceId])
}

// ─────────────────────────────────────────────
// HOSPITAL & DEPARTMENT
// ─────────────────────────────────────────────

model Hospital {
  id             String     @id @default(cuid())
  name           String
  address        String
  city           String
  latitude       Float
  longitude      Float
  contactPhone   String
  contactEmail   String
  crowdLevel     CrowdLevel @default(LOW)
  rating         Float?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  departments        Department[]
  doctors            Doctor[]
  hospitalAdmins     HospitalAdmin[]
  receptionists      Receptionist[]
  pharmacists        Pharmacist[]
  labStaff           LabStaff[]
  ambulanceDrivers   AmbulanceDriver[]
  ambulances         Ambulance[]
  appointments       Appointment[]
  pharmacyOrders     PharmacyOrder[]
  labRequests        LabRequest[]
  bills              Bill[]
  emergencyRequests  EmergencyRequest[]
  passportConsents   PassportConsent[]  @relation("HospitalConsentGrants")
  auditLogs          AuditLog[]
}

model Department {
  id         String   @id @default(cuid())
  name       String
  hospitalId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  doctors    Doctor[]

  @@index([hospitalId])
}

// ─────────────────────────────────────────────
// DOCTOR AVAILABILITY
// ─────────────────────────────────────────────

model DoctorAvailability {
  id                  String   @id @default(cuid())
  doctorId            String
  dayOfWeek           Int      // 0=Sunday ... 6=Saturday
  startTime           String   // "09:00"
  endTime             String   // "17:00"
  slotDurationMinutes Int      @default(15)
  maxPatients         Int      @default(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// ─────────────────────────────────────────────
// APPOINTMENTS & QUEUE
// ─────────────────────────────────────────────

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  hospitalId      String
  appointmentDate DateTime
  appointmentTime String            // "10:30"
  status          AppointmentStatus @default(PENDING_PAYMENT)
  notes           String?
  isLiteAppointment Boolean         @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient         Patient      @relation(fields: [patientId], references: [id])
  doctor          Doctor       @relation(fields: [doctorId], references: [id])
  hospital        Hospital     @relation(fields: [hospitalId], references: [id])
  queueToken      QueueToken?
  consultation    Consultation?
  bills           Bill[]

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([status])
}

model QueueToken {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  position      Int
  status        QueueStatus @default(WAITING)
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([status])
}

// ─────────────────────────────────────────────
// HEALTHCARE PASSPORT
// ─────────────────────────────────────────────

model HealthcarePassport {
  id                  String   @id @default(cuid())
  patientId           String   @unique
  bloodGroup          String?
  allergyList         Json     @default("[]")
  chronicConditions   Json     @default("[]")
  vaccinationHistory  Json     @default("[]")
  consultationHistory Json     @default("[]")
  prescriptionHistory Json     @default("[]")
  labHistory          Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consents  PassportConsent[]

  @@index([patientId])
}

model PassportConsent {
  id                    String    @id @default(cuid())
  passportId            String
  grantedToDoctorId     String?
  grantedToHospitalId   String?
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  passport            HealthcarePassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  grantedToDoctor     Doctor?            @relation("DoctorConsentGrants", fields: [grantedToDoctorId], references: [id])
  grantedToHospital   Hospital?          @relation("HospitalConsentGrants", fields: [grantedToHospitalId], references: [id])

  @@index([passportId])
  @@index([grantedToDoctorId])
  @@index([grantedToHospitalId])
}

// ─────────────────────────────────────────────
// CONSULTATION & PRESCRIPTION
// ─────────────────────────────────────────────

model Consultation {
  id               String    @id @default(cuid())
  appointmentId    String    @unique
  doctorId         String
  patientId        String
  chiefComplaint   String
  examinationNotes String?
  diagnosis        String?
  referralNotes    String?
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointment  Appointment  @relation(fields: [appointmentId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])  // Note: no back-relation in Patient for simplicity; query via Appointment
  prescriptions Prescription[]
  labRequests  LabRequest[]

  @@index([appointmentId])
  @@index([doctorId])
  @@index([patientId])
}

// Note: Patient model doesn't have a direct consultations relation; use Appointment -> Consultation
// This avoids a circular relation. Queries go: Patient -> Appointments -> Consultation

model Prescription {
  id            String    @id @default(cuid())
  consultationId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consultation  Consultation      @relation(fields: [consultationId], references: [id])
  items         PrescriptionItem[]
  pharmacyOrder PharmacyOrder?

  @@index([consultationId])
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription    Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine        Medicine         @relation(fields: [medicineId], references: [id])
  medicineReminders MedicineReminder[]

  @@index([prescriptionId])
  @@index([medicineId])
}

model Medicine {
  id            String   @id @default(cuid())
  name          String
  genericName   String?
  category      String
  unit          String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prescriptionItems   PrescriptionItem[]
  pharmacyOrderItems  PharmacyOrderItem[]
}

// ─────────────────────────────────────────────
// PHARMACY
// ─────────────────────────────────────────────

model PharmacyOrder {
  id            String              @id @default(cuid())
  patientId     String
  hospitalId    String
  prescriptionId String?            @unique
  status        PharmacyOrderStatus @default(PENDING)
  totalAmount   Decimal
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  patient      Patient              @relation(fields: [patientId], references: [id])
  hospital     Hospital             @relation(fields: [hospitalId], references: [id])
  prescription Prescription?        @relation(fields: [prescriptionId], references: [id])
  items        PharmacyOrderItem[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([prescriptionId])
  @@index([status])
}

model PharmacyOrderItem {
  id              String   @id @default(cuid())
  pharmacyOrderId String
  medicineId      String
  quantity        Int
  unitPrice       Decimal
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pharmacyOrder PharmacyOrder @relation(fields: [pharmacyOrderId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@index([pharmacyOrderId])
  @@index([medicineId])
}

model MedicineReminder {
  id                String   @id @default(cuid())
  patientId         String
  prescriptionItemId String
  reminderTime      String   // "08:00"
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionItem  PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([prescriptionItemId])
}

// ─────────────────────────────────────────────
// LABORATORY
// ─────────────────────────────────────────────

model LabTestCatalog {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  price       Decimal
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labRequestItems LabRequestItem[]
}

model LabRequest {
  id            String           @id @default(cuid())
  consultationId String
  patientId     String
  hospitalId    String
  status        LabRequestStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  consultation  Consultation    @relation(fields: [consultationId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  hospital      Hospital        @relation(fields: [hospitalId], references: [id])
  items         LabRequestItem[]

  @@index([consultationId])
  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
}

model LabRequestItem {
  id               String   @id @default(cuid())
  labRequestId     String
  labTestCatalogId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  labRequest     LabRequest     @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  labTestCatalog LabTestCatalog @relation(fields: [labTestCatalogId], references: [id])
  labReport      LabReport?

  @@index([labRequestId])
  @@index([labTestCatalogId])
}

model LabReport {
  id                 String   @id @default(cuid())
  labRequestItemId   String   @unique
  fileUrl            String
  findings           String?
  uploadedByLabStaffId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  labRequestItem  LabRequestItem @relation(fields: [labRequestItemId], references: [id], onDelete: Cascade)
  uploadedBy      LabStaff       @relation(fields: [uploadedByLabStaffId], references: [id])

  @@index([labRequestItemId])
  @@index([uploadedByLabStaffId])
}

// ─────────────────────────────────────────────
// BILLING & PAYMENTS
// ─────────────────────────────────────────────

model Bill {
  id            String   @id @default(cuid())
  patientId     String
  hospitalId    String
  appointmentId String?
  totalAmount   Decimal
  isPaid        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient     Patient     @relation(fields: [patientId], references: [id])
  hospital    Hospital    @relation(fields: [hospitalId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  items       BillItem[]
  payments    Payment[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([appointmentId])
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  description String
  amount      Decimal
  itemType    String   // "APPOINTMENT" | "PHARMACY" | "LAB" | "OTHER"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model Payment {
  id                 String        @id @default(cuid())
  billId             String
  patientId          String
  amount             Decimal
  status             PaymentStatus @default(PENDING)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bill    Bill    @relation(fields: [billId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([billId])
  @@index([patientId])
  @@index([status])
}

// ─────────────────────────────────────────────
// EMERGENCY
// ─────────────────────────────────────────────

model EmergencyRequest {
  id           String          @id @default(cuid())
  patientId    String
  ambulanceId  String?
  hospitalId   String?
  latitude     Float
  longitude    Float
  description  String?
  status       EmergencyStatus @default(PENDING)
  dispatchedAt DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  ambulance Ambulance? @relation(fields: [ambulanceId], references: [id])
  hospital  Hospital?  @relation(fields: [hospitalId], references: [id])

  @@index([patientId])
  @@index([ambulanceId])
  @@index([hospitalId])
  @@index([status])
}

model Ambulance {
  id            String   @id @default(cuid())
  hospitalId    String
  vehicleNumber String
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital          Hospital          @relation(fields: [hospitalId], references: [id])
  emergencyRequests EmergencyRequest[]
  drivers           AmbulanceDriver[]

  @@index([hospitalId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS & AUDIT
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  hospitalId     String?
  action         String
  targetEntity   String
  targetEntityId String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor    User      @relation(fields: [actorUserId], references: [id])
  hospital Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([actorUserId])
  @@index([hospitalId])
}
