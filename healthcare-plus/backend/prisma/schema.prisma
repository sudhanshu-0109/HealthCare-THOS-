// ============================================================
// backend/prisma/schema.prisma
// Phase 5: Appointments, Payments, DoctorAvailability
// Phase 6: QueueToken
// Phase 7: HealthcarePassport, PassportConsent, MedicalTimeline
// Phase 8: Consultation, Prescription, LabRequest, FollowUpRecommendation
// Phase 9: Medicine, PharmacyOrder, MedicineReminder
// Phase 10: LabTestCatalog, LabReport, Notification
// Phase 11: Lite Appointments (fields on Doctor + Appointment)
// Phase 12: Bill, BillItem, unified Payment path
// Phase 13: Ambulance, extended EmergencyRequest dispatch fields
// Phase 14: AuditLog
// Phase 17: Mental Wellness Ecosystem (MentalHealthProfile, AI Companion, Safety Engine)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  RECEPTIONIST
  PHARMACIST
  LAB_STAFF
  AMBULANCE_DRIVER
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  BOTH
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum EmergencyStatus {
  REQUESTED
  SEARCHING
  DRIVER_ASSIGNED
  EN_ROUTE
  REACHED_PATIENT           // Auto-triggered when ambulance <= 100m from patient
  PICKUP_PENDING_CONFIRMATION // Driver marked pickup; awaiting patient's confirmation
  PICKED_UP
  ARRIVED
  CANCELLED
  NO_DRIVER_FALLBACK
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
}

// Phase 12: Unified billing enums
enum BillSourceType {
  APPOINTMENT
  PHARMACY_ORDER
  LAB_REQUEST
}

enum BillStatus {
  UNPAID
  PAID
  CANCELLED
}

// Decision: tokenNumber is Float (not Int) so Phase 11 Lite Appointments
// can insert fractional tokens (e.g. 15.5) without a breaking schema change.
enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

// Decision: MedicalTimelineEvent uses polymorphic sourceId+eventType
// instead of per-type FKs because Consultation/Prescription/LabReport
// models don't exist until Phases 8-10.
enum TimelineEventType {
  APPOINTMENT
  CONSULTATION
  PRESCRIPTION
  LAB_REQUEST
  LAB_REPORT
  MEDICATION
}

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
}

enum LabRequestPriority {
  ROUTINE
  URGENT
}

enum LabRequestStatus {
  PENDING
  CONFIRMED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  BOOKED
  DISMISSED
}

enum AppointmentType {
  REGULAR
  LITE
}

// Phase 16: Online Consultation
enum ConsultationType {
  OFFLINE
  ONLINE
}

enum OnlineSessionStatus {
  SCHEDULED
  WAITING_FOR_PARTICIPANTS
  PATIENT_JOINED
  DOCTOR_JOINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────
// PHASE 17: MENTAL WELLNESS ENUMS
// ─────────────────────────────────────────────

// Three-tier consent model (Section 16 of spec)
enum MentalHealthConsentLevel {
  NONE
  LEVEL_1 // Wellness tracking: mood, stress, sleep, activities
  LEVEL_2 // AI Companion: conversations, journal, insights
  LEVEL_3 // Professional Care: sessions, care plans, clinical notes
}

// Risk classification output (Section 7 of spec)
enum RiskLevel {
  GREEN
  YELLOW
  ORANGE
  RED
}

// Supported wellness activity content types (Section 8)
enum WellnessContentType {
  BREATHING
  MEDITATION
  MINDFULNESS
  SLEEP_SOUND
  SLEEP_STORY
  RELAXATION_MUSIC
  GRATITUDE
  GROUNDING
  FOCUS
  WELLNESS_PROGRAM
}

// Conversation intent categories (Section 6.3)
enum WellnessIntentType {
  SLEEP_SUPPORT
  STRESS_SUPPORT
  FOCUS_SUPPORT
  SOCIAL_SUPPORT
  RELAXATION
  MEDITATION
  REFLECTION
  PROFESSIONAL_SUPPORT
  GENERAL
}

// Supported emotional states (Section 6.2)
enum WellnessEmotionType {
  CALM
  HAPPY
  NEUTRAL
  SAD
  LOW
  STRESSED
  OVERWHELMED
  ANXIOUS
  ANGRY
  LONELY
  FRUSTRATED
}

// Trusted contact notification policy (Section 15)
enum TrustedContactPolicy {
  NEVER
  ASK_FIRST
  APPROVED_EMERGENCY_ONLY
}

// Crisis flow action types
enum CrisisActionType {
  VIEWED_RESOURCES
  CALLED_HELPLINE
  CONTACTED_TRUSTED_PERSON
  BOOKED_PROFESSIONAL
  DISMISSED
}

// ─────────────────────────────────────────────
// USER & PROFILES
// ─────────────────────────────────────────────

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String?
  fullName        String
  role            Role
  isEmailVerified Boolean      @default(false)
  googleId        String?      @unique
  authProvider    AuthProvider @default(LOCAL)
  status          UserStatus   @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Role profiles
  patientProfile   PatientProfile?
  doctor           Doctor?
  hospitalAdmin    HospitalAdmin?
  receptionist     Receptionist?
  pharmacist       Pharmacist?
  labStaff         LabStaff?
  ambulanceDriver  AmbulanceDriver?

  // Auth tokens
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  inviteTokens        InviteToken[]
  
  // Patient specific
  emergencyRequests      EmergencyRequest[]
  appointments           Appointment[]
  passport               HealthcarePassport?
  consultationsAsPatient Consultation[]
  medicineReminders      MedicineReminder[]
  notifications          Notification[]

  // Phase 12: Billing
  bills       Bill[]

  // Phase 14: Audit log
  auditLogs   AuditLog[]

  // Phase 17: Mental Wellness
  mentalHealthProfile MentalHealthProfile?

  @@index([role])
  @@map("users")
}

model PatientProfile {
  id                    String      @id @default(uuid())
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            BloodGroup?
  profilePhotoUrl       String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("patient_profiles")
}

// ─────────────────────────────────────────────
// AUTH TOKEN MODELS
// ─────────────────────────────────────────────

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model InviteToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  invitedBy  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("invite_tokens")
}

// ─────────────────────────────────────────────
// HOSPITALS & DEPARTMENTS
// ─────────────────────────────────────────────

model Hospital {
  id                String   @id @default(uuid())
  name              String
  address           String
  locality          String?  // Neighbourhood / area within city (e.g. "Alkapuri", "Race Course")
  city              String
  state             String?  @default("Gujarat")
  country           String?  @default("India")
  latitude          Float
  longitude         Float
  contactPhone      String
  contactEmail      String
  workingHoursOpen  String?
  workingHoursClose String?
  specialities      String[]
  averageRating     Float?   @default(0)
  hospitalType      String?  @default("Private")   // "Private" | "Government" | "Trust"
  ownershipType     String?                         // "Corporate" | "Charitable" | "Govt"
  ratingSource      String?                         // "Google Maps" | "Justdial" | "Internal"
  totalReviews      Int?     @default(0)
  isDemoEntity      Boolean  @default(true)         // All real-world-ref hospitals are demo entities
  notes             String?                         // Internal notes / source confidence
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  departments       Department[]
  doctors           Doctor[]
  hospitalAdmins    HospitalAdmin[]
  receptionists     Receptionist[]
  pharmacists       Pharmacist[]
  labStaff          LabStaff[]
  ambulanceDrivers  AmbulanceDriver[]
  emergencyRequests EmergencyRequest[]
  appointments      Appointment[]
  queueTokens       QueueToken[]
  passportConsents  PassportConsent[]
  consultations     Consultation[]
  medicines         Medicine[]
  pharmacyOrders    PharmacyOrder[]
  labTestCatalog    LabTestCatalog[]

  // Phase 12: Billing
  bills             Bill[]

  // Phase 13: Ambulances
  ambulances        Ambulance[]

  // Phase 14: Audit log
  auditLogs         AuditLog[]

  @@map("hospitals")
}

model Department {
  id         String   @id @default(uuid())
  name       String
  hospitalId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctors      Doctor[]
  appointments Appointment[]

  @@index([hospitalId])
  @@map("departments")
}

// ─────────────────────────────────────────────
// STAFF PROFILES
// ─────────────────────────────────────────────

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique
  hospitalId      String
  departmentId    String
  specialization  String
  experienceYears Int
  consultationFee Decimal
  bio             String?
  qualification   String?
  averageRating   Float?   @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Phase 11 Lite Appointment fields
  acceptsLiteAppointments Boolean  @default(false)
  liteConsultationFee     Decimal?
  liteSlotMinutes         Int      @default(5)

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital         Hospital             @relation(fields: [hospitalId], references: [id])
  department       Department           @relation(fields: [departmentId], references: [id])
  availability     DoctorAvailability[]
  appointments     Appointment[]
  queueTokens      QueueToken[]
  passportConsents PassportConsent[]
  consultations    Consultation[]

  @@index([userId])
  @@index([hospitalId])
  @@index([departmentId])
  @@map("doctors")
}

model HospitalAdmin {
  id         String   @id @default(uuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([userId])
  @@index([hospitalId])
  @@map("hospital_admins")
}

model Receptionist {
  id         String   @id @default(uuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("receptionists")
}

model Pharmacist {
  id         String   @id @default(uuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("pharmacists")
}

model LabStaff {
  id         String   @id @default(uuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@map("lab_staff")
}

model AmbulanceDriver {
  id         String   @id @default(uuid())
  userId     String   @unique
  hospitalId String
  createdAt  DateTime @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital  @relation(fields: [hospitalId], references: [id])
  ambulance  Ambulance?

  @@index([hospitalId])
  @@map("ambulance_drivers")
}

// ─────────────────────────────────────────────
// EMERGENCY
// ─────────────────────────────────────────────

model EmergencyRequest {
  id          String          @id @default(uuid())
  patientId   String
  patient     User            @relation(fields: [patientId], references: [id])
  hospitalId  String?
  hospital    Hospital?       @relation(fields: [hospitalId], references: [id])
  latitude    Float
  longitude   Float
  status      EmergencyStatus @default(REQUESTED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Phase 13: Dispatch fields
  ambulanceId            String?
  ambulance              Ambulance? @relation(fields: [ambulanceId], references: [id])
  destinationHospitalId  String?
  acceptedAt             DateTime?
  reachedPatientAt       DateTime?  // Stamped when auto-proximity (<=100m) or manual reached
  pickupConfirmedAt      DateTime?  // Stamped when patient confirms pickup
  pickedUpAt             DateTime?
  arrivedAt              DateTime?
  cancelReason           String?
  // Real-time location cache — updated on every driver GPS event so patients
  // can recover the last known ambulance position after a page refresh.
  lastDriverLat          Float?
  lastDriverLng          Float?

  @@index([patientId])
  @@index([status])
  @@map("emergency_requests")
}

// ─────────────────────────────────────────────
// PHASE 13: AMBULANCE
// ─────────────────────────────────────────────

model Ambulance {
  id                String   @id @default(uuid())
  hospitalId        String
  hospital          Hospital @relation(fields: [hospitalId], references: [id])
  driverId          String   @unique
  driver            AmbulanceDriver @relation(fields: [driverId], references: [id])
  vehicleNumber     String
  isActive          Boolean  @default(true)
  isOnline          Boolean  @default(false)
  currentLatitude   Float?
  currentLongitude  Float?
  locationUpdatedAt DateTime?

  emergencyRequests EmergencyRequest[]

  @@index([hospitalId])
  @@index([isOnline, isActive])
  @@map("ambulances")
}

// ─────────────────────────────────────────────
// PHASE 5: DOCTOR AVAILABILITY & APPOINTMENTS
// ─────────────────────────────────────────────

model DoctorAvailability {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = Sunday ... 6 = Saturday
  startTime   String   // "09:00"
  endTime     String   // "13:00"
  slotMinutes Int      @default(15)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([doctorId])
  @@map("doctor_availability")
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       User              @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  hospitalId    String
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  departmentId  String
  department    Department        @relation(fields: [departmentId], references: [id])
  scheduledDate DateTime          // stored at midnight UTC
  scheduledTime String            // "09:15"
  fee           Decimal
  status        AppointmentStatus @default(PENDING_PAYMENT)
  cancelReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  appointmentType  AppointmentType  @default(REGULAR)

  // Phase 16: Online Consultation
  consultationType ConsultationType @default(OFFLINE)

  // Phase 12: payments now go through Bill; direct Payment relation removed
  queueToken    QueueToken?
  consultation  Consultation?

  // Phase 16: online-only — null for every offline/seeded appointment
  onlineSession OnlineSession?

  // DB-level double-booking prevention (LITE appointments use null scheduledTime)
  @@index([hospitalId])
  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([consultationType])
  @@map("appointments")
}

// ─────────────────────────────────────────────
// PHASE 12: UNIFIED BILLING
// ─────────────────────────────────────────────

model Bill {
  id          String         @id @default(uuid())
  patientId   String
  patient     User           @relation(fields: [patientId], references: [id])
  hospitalId  String
  hospital    Hospital       @relation(fields: [hospitalId], references: [id])
  sourceType  BillSourceType
  sourceId    String         // Appointment.id | PharmacyOrder.id | LabRequest.id
  subtotal    Decimal
  discount    Decimal        @default(0)
  tax         Decimal        @default(0)
  total       Decimal
  status      BillStatus     @default(UNPAID)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items    BillItem[]
  payments Payment[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@map("bills")
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String
  bill        Bill    @relation(fields: [billId], references: [id])
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal
  subtotal    Decimal

  @@index([billId])
  @@map("bill_items")
}

model Payment {
  id                String        @id @default(uuid())
  // Phase 12: links to Bill (not directly to Appointment)
  // Migration: phase12-migrate-payments.js handles existing Payment rows
  billId             String
  bill               Bill          @relation(fields: [billId], references: [id])
  amount             Decimal
  currency           String        @default("INR")
  razorpayOrderId    String        @unique
  razorpayPaymentId  String?
  razorpaySignature  String?
  status             PaymentStatus @default(CREATED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([billId])
  @@map("payments")
}

// ─────────────────────────────────────────────
// PHASE 6: QUEUE TOKENS
// ─────────────────────────────────────────────

model QueueToken {
  id                  String      @id @default(uuid())
  appointmentId       String      @unique
  appointment         Appointment @relation(fields: [appointmentId], references: [id])
  doctorId            String
  doctor              Doctor      @relation(fields: [doctorId], references: [id])
  hospitalId          String
  hospital            Hospital    @relation(fields: [hospitalId], references: [id])
  queueDate           DateTime    // date-only grouping
  tokenNumber         Float       // Float: supports fractional Phase 11 Lite tokens
  status              QueueStatus @default(WAITING)
  calledAt            DateTime?
  consultationStartAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  consultation Consultation?

  @@index([doctorId, queueDate])
  @@index([hospitalId])
  @@index([status])
  @@map("queue_tokens")
}

// ─────────────────────────────────────────────
// PHASE 7: HEALTHCARE PASSPORT & TIMELINE
// ─────────────────────────────────────────────

model HealthcarePassport {
  id                 String   @id @default(uuid())
  patientId          String   @unique
  patient            User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies          String[]
  medicalConditions  String[]
  currentMedications String[]
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  consents       PassportConsent[]
  timelineEvents MedicalTimelineEvent[]

  @@map("healthcare_passports")
}

model PassportConsent {
  id         String             @id @default(uuid())
  passportId String
  passport   HealthcarePassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  hospitalId String?
  hospital   Hospital?          @relation(fields: [hospitalId], references: [id])
  doctorId   String?
  doctor     Doctor?            @relation(fields: [doctorId], references: [id])
  grantedAt  DateTime           @default(now())
  revokedAt  DateTime?

  @@index([passportId])
  @@map("passport_consents")
}

model MedicalTimelineEvent {
  id          String             @id @default(uuid())
  passportId  String
  passport    HealthcarePassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  eventType   TimelineEventType
  sourceId    String
  title       String
  description String?
  eventDate   DateTime
  createdAt   DateTime           @default(now())

  @@index([passportId])
  @@index([eventType])
  @@map("medical_timeline_events")
}

// ─────────────────────────────────────────────
// PHASE 8: CONSULTATION & CLINICAL WORKFLOW
// ─────────────────────────────────────────────

model Consultation {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  appointment   Appointment        @relation(fields: [appointmentId], references: [id])

  // Phase 16: queueTokenId is OPTIONAL — online consultations have no queue token.
  // All existing offline consultations retain their queueTokenId values unchanged.
  queueTokenId  String?            @unique
  queueToken    QueueToken?        @relation(fields: [queueTokenId], references: [id])

  // Phase 16: link back to OnlineSession (null for all offline consultations)
  onlineSessionId String?          @unique
  onlineSession   OnlineSession?   @relation(fields: [onlineSessionId], references: [id])

  doctorId      String
  doctor        Doctor             @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       User               @relation(fields: [patientId], references: [id])
  hospitalId    String
  hospital      Hospital           @relation(fields: [hospitalId], references: [id])
  symptoms      String?
  diagnosis     String?
  notes         String?
  treatmentPlan String?
  status        ConsultationStatus @default(IN_PROGRESS)
  startedAt     DateTime           @default(now())
  completedAt   DateTime?

  prescription Prescription?
  labRequests  LabRequest[]
  followUp     FollowUpRecommendation?

  @@index([doctorId])
  @@index([patientId])
  @@index([hospitalId])
  @@map("consultations")
}

// ─────────────────────────────────────────────
// PHASE 16: ONLINE SESSION
// ─────────────────────────────────────────────

model OnlineSession {
  id              String              @id @default(uuid())
  appointmentId   String              @unique
  appointment     Appointment         @relation(fields: [appointmentId], references: [id])

  // Secure, server-generated room identifier — never exposed directly in URLs
  roomId          String              @unique @default(uuid())

  status          OnlineSessionStatus @default(SCHEDULED)
  scheduledStart  DateTime
  scheduledEnd    DateTime?

  startedAt       DateTime?
  endedAt         DateTime?
  patientJoinedAt DateTime?
  doctorJoinedAt  DateTime?
  endedReason     String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Clinical record created when doctor starts the call
  consultation    Consultation?

  @@index([status])
  @@index([scheduledStart])
  @@map("online_sessions")
}

model Prescription {
  id                  String   @id @default(uuid())
  consultationId      String   @unique
  consultation        Consultation @relation(fields: [consultationId], references: [id])
  doctorId            String
  patientId           String
  hospitalId          String
  generalInstructions String?
  createdAt           DateTime @default(now())

  items         PrescriptionItem[]
  pharmacyOrder PharmacyOrder?

  @@index([patientId])
  @@index([hospitalId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicineName   String
  dosage         String
  frequency      String
  durationDays   Int
  instructions   String?

  pharmacyOrderItem PharmacyOrderItem?

  @@index([prescriptionId])
  @@map("prescription_items")
}

model LabRequest {
  id             String             @id @default(uuid())
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  doctorId       String
  patientId      String
  hospitalId     String
  priority       LabRequestPriority @default(ROUTINE)
  notes          String?
  status         LabRequestStatus   @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items   LabRequestItem[]
  reports LabReport[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
  @@map("lab_requests")
}

model LabRequestItem {
  id             String       @id @default(uuid())
  labRequestId   String
  labRequest     LabRequest   @relation(fields: [labRequestId], references: [id])
  testName       String
  estimatedPrice Decimal?

  @@index([labRequestId])
  @@map("lab_request_items")
}

model FollowUpRecommendation {
  id                  String         @id @default(uuid())
  consultationId      String         @unique
  consultation        Consultation   @relation(fields: [consultationId], references: [id])
  patientId           String
  doctorId            String
  recommendedDate     DateTime
  reason              String?
  status              FollowUpStatus @default(PENDING)
  bookedAppointmentId String?
  createdAt           DateTime       @default(now())

  @@index([patientId])
  @@map("follow_up_recommendations")
}

// ─────────────────────────────────────────────
// PHASE 9: PHARMACY & MEDICINE REMINDERS
// ─────────────────────────────────────────────

enum PharmacyOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PACKED
  READY
  COMPLETED
  CANCELLED
}

enum ReminderLogStatus {
  PENDING
  TAKEN
  MISSED
}

model Medicine {
  id            String   @id @default(uuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
  name          String
  genericName   String?
  manufacturer  String?
  unit          String
  price         Decimal
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pharmacyOrderItems PharmacyOrderItem[]

  @@index([hospitalId])
  @@map("medicines")
}

model PharmacyOrder {
  id             String              @id @default(uuid())
  prescriptionId String              @unique
  prescription   Prescription        @relation(fields: [prescriptionId], references: [id])
  patientId      String
  hospitalId     String
  hospital       Hospital            @relation(fields: [hospitalId], references: [id])
  status         PharmacyOrderStatus @default(PENDING)
  totalAmount    Decimal             @default(0)
  isPaid         Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items PharmacyOrderItem[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
  @@map("pharmacy_orders")
}

model PharmacyOrderItem {
  id                 String        @id @default(uuid())
  pharmacyOrderId    String
  pharmacyOrder      PharmacyOrder @relation(fields: [pharmacyOrderId], references: [id])
  prescriptionItemId String        @unique
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicineId         String?
  medicine           Medicine?     @relation(fields: [medicineId], references: [id])
  quantity           Int           @default(1)
  unitPrice          Decimal?
  subtotal           Decimal?

  @@index([pharmacyOrderId])
  @@map("pharmacy_order_items")
}

model MedicineReminder {
  id              String   @id @default(uuid())
  patientId       String
  patient         User     @relation(fields: [patientId], references: [id])
  pharmacyOrderId String?
  medicineName    String
  dosage          String
  frequency       String
  startDate       DateTime
  endDate         DateTime
  reminderTimes   String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  logs MedicineReminderLog[]

  @@index([patientId])
  @@map("medicine_reminders")
}

model MedicineReminderLog {
  id           String            @id @default(uuid())
  reminderId   String
  reminder     MedicineReminder  @relation(fields: [reminderId], references: [id])
  scheduledFor DateTime
  status       ReminderLogStatus @default(PENDING)
  markedAt     DateTime?

  @@unique([reminderId, scheduledFor])
  @@index([reminderId])
  @@map("medicine_reminder_logs")
}

// ─────────────────────────────────────────────
// PHASE 10: LABORATORY & NOTIFICATIONS
// ─────────────────────────────────────────────

enum NotificationType {
  LAB_REPORT_READY
  PHARMACY_ORDER_UPDATE
  APPOINTMENT_REMINDER
  EMERGENCY_NOTIFICATION
  GENERAL
  // Phase 15 additions
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  QUEUE_YOUR_TURN
  QUEUE_YOUR_TURN_APPROACHING
  CONSULTATION_COMPLETED
  PAYMENT_RESULT
  BILL_GENERATED
  PASSPORT_ACCESS_CHANGED
  // Phase 16: Online Consultation
  ONLINE_CONSULTATION_CONFIRMED
  ONLINE_CONSULTATION_REMINDER
  ONLINE_SESSION_STARTING
  ONLINE_SESSION_STARTED
  ONLINE_SESSION_COMPLETED
  // Phase 17: Lab + Pharmacy granular notifications
  LAB_REQUEST_CREATED
  LAB_BILL_GENERATED
  LAB_SAMPLE_REQUESTED
  LAB_PROCESSING
  PRESCRIPTION_CREATED
  PHARMACY_BILL_GENERATED
  // Phase 17: Mental Wellness
  MENTAL_HEALTH_CRISIS
  MENTAL_WELLNESS_CHECKIN_REMINDER
  MENTAL_WELLNESS_STREAK
}

model MasterLabCategory {
  id    String @id @default(uuid())
  name  String @unique
  tests MasterLabTest[]

  @@map("master_lab_categories")
}

model MasterLabTest {
  id           String            @id @default(uuid())
  code         String            @unique
  categoryId   String
  category     MasterLabCategory @relation(fields: [categoryId], references: [id])
  name         String
  basePrice    Decimal
  sampleType   String?
  isActive     Boolean           @default(true)

  hospitalTests LabTestCatalog[]

  @@map("master_lab_tests")
}

model LabTestCatalog {
  id           String         @id @default(uuid())
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  masterTestId String?
  masterTest   MasterLabTest? @relation(fields: [masterTestId], references: [id])
  name         String
  price        Decimal
  sampleType   String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  @@index([hospitalId])
  @@index([masterTestId])
  @@map("lab_test_catalog")
}

model LabReport {
  id               String     @id @default(uuid())
  labRequestId     String
  labRequest       LabRequest @relation(fields: [labRequestId], references: [id])
  labRequestItemId String?
  resultSummary    String?
  reportFileUrl    String
  reportDate       DateTime   @default(now())
  uploadedByUserId String
  createdAt        DateTime   @default(now())

  @@index([labRequestId])
  @@map("lab_reports")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// PHASE 14: AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [id])
  action       String   // e.g. "DOCTOR_ADDED", "FEE_CHANGED", "QUEUE_OVERRIDDEN"
  targetType   String   // e.g. "Doctor", "Department", "QueueToken"
  targetId     String?
  metadata     Json?    // arbitrary before/after values, kept loose deliberately
  createdAt    DateTime @default(now())

  @@index([hospitalId])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// PHASE 17: MENTAL WELLNESS ECOSYSTEM
// ─────────────────────────────────────────────

// Per-user mental wellness profile and consent tier.
// Consent level is the authoritative source — checked by consentCheck middleware.
model MentalHealthProfile {
  id           String                   @id @default(uuid())
  userId       String                   @unique
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentLevel MentalHealthConsentLevel @default(NONE)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  checkIns              MentalHealthCheckIn[]
  conversations         AIConversation[]
  riskEvents            MentalHealthRiskEvent[]
  trustedContacts       TrustedContact[]
  activities            WellnessActivity[]
  recommendations       WellnessRecommendation[]
  programEnrollments    WellnessProgramEnrollment[]
  gratitudeEntries      GratitudeEntry[]
  professionalConnections ProfessionalConnection[]

  @@map("mental_health_profiles")
}

// Daily mood/wellness check-in (Zone A - Section 4).
// Free-text note passes through safety engine before storage.
model MentalHealthCheckIn {
  id           String              @id @default(uuid())
  profileId    String
  profile      MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  checkInDate  String?             // YYYY-MM-DD local date string; null for legacy rows
  mood         Int                 // 1=Overwhelmed ... 5=Great
  stress       Int                 // 0-10
  energy       Int                 // 1-5
  motivation   Int                 // 1-5
  sleepHours   Float?
  note         String?             // safety-scanned before storage
  noteRiskLevel RiskLevel?         // risk level of the note scan
  createdAt    DateTime            @default(now())
  updatedAt    DateTime?           @updatedAt

  @@index([profileId])
  @@index([createdAt])
  // Compound unique: one authoritative check-in per user per calendar day.
  // This is the DB-level enforcement of the one-per-day contract.
  // Legacy rows with null checkInDate are excluded from the unique constraint.
  @@unique([profileId, checkInDate])
  @@map("mental_health_check_ins")
}


// AI conversation session (Zone B - Section 4).
model AIConversation {
  id          String              @id @default(uuid())
  profileId   String
  profile     MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String?             // auto-generated from first message
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  messages        AIConversationMessage[]
  riskAssessments AIRiskAssessment[]

  @@index([profileId])
  @@index([createdAt])
  @@map("ai_conversations")
}

// Individual message within an AI conversation.
// promptVersion stored so every AI call is reproducible for audit.
model AIConversationMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // 'user' | 'assistant'
  content        String
  emotion        WellnessEmotionType?
  emotionIntensity Int?
  intent         WellnessIntentType?
  riskLevel      RiskLevel?
  promptVersion  String?        // e.g. 'wellness-v1.0'
  modelVersion   String?        // e.g. 'gemini-1.5-flash'
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("ai_conversation_messages")
}

// Full audit record of every risk classification call.
// Stored for every level (GREEN through RED) — never skipped.
// Append-only: no destructive updates.
model AIRiskAssessment {
  id               String         @id @default(uuid())
  conversationId   String
  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inputText        String         // the user message that triggered this assessment
  ruleBasedLevel   RiskLevel      // output from rule-based keyword classifier
  aiClassifiedLevel RiskLevel     // output from Gemini structured classifier
  finalLevel       RiskLevel      // the more cautious of the two
  requiresEscalation Boolean
  aiReasoning      String?        // Gemini's reasoning text
  promptVersion    String         // risk prompt version used
  modelVersion     String         // Gemini model version used
  createdAt        DateTime       @default(now())

  @@index([conversationId])
  @@index([finalLevel])
  @@index([createdAt])
  @@map("ai_risk_assessments")
}

// Append-only risk event log for ORANGE and RED events.
// No destructive updates allowed — safety audit trail.
model MentalHealthRiskEvent {
  id          String              @id @default(uuid())
  profileId   String
  profile     MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  riskLevel   RiskLevel
  triggerText String              // the message that triggered the event
  sessionId   String?             // conversation ID if from AI companion
  resolvedAt  DateTime?           // set when user completes crisis flow
  createdAt   DateTime            @default(now())

  crisisActions CrisisAction[]

  @@index([profileId])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("mental_health_risk_events")
}

// Records individual user actions taken during the crisis flow (RED path).
model CrisisAction {
  id           String               @id @default(uuid())
  riskEventId  String
  riskEvent    MentalHealthRiskEvent @relation(fields: [riskEventId], references: [id], onDelete: Cascade)
  actionType   CrisisActionType
  metadata     Json?                // e.g. which helpline was called
  createdAt    DateTime             @default(now())

  @@index([riskEventId])
  @@map("crisis_actions")
}

// Opt-in trusted contact with server-enforced notification policy (Section 15).
model TrustedContact {
  id                 String                  @id @default(uuid())
  profileId          String
  profile            MentalHealthProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name               String
  relationship       String
  phone              String
  notificationPolicy TrustedContactPolicy    @default(ASK_FIRST)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([profileId])
  @@map("trusted_contacts")
}

// Governed wellness content library — all AI recommendations must come from here.
// Never let the AI invent activities outside this set (Section 8).
model WellnessContent {
  id          String              @id @default(uuid())
  type        WellnessContentType
  title       String
  description String?
  duration    Int?                // minutes
  tags        String[]            // e.g. ["STRESS", "ANXIETY", "FOCUS"]
  audioUrl    String?
  imageUrl    String?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())

  activities      WellnessActivity[]
  recommendations WellnessRecommendation[]

  @@index([type])
  @@index([isActive])
  @@map("wellness_content")
}

// Wellness program definition (structured multi-day programs).
model WellnessProgram {
  id          String   @id @default(uuid())
  title       String
  description String?
  durationDays Int
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  enrollments WellnessProgramEnrollment[]

  @@map("wellness_programs")
}

// User's completion record for a wellness activity.
model WellnessActivity {
  id          String              @id @default(uuid())
  profileId   String
  profile     MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentId   String
  content     WellnessContent     @relation(fields: [contentId], references: [id])
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  durationSeconds Int?            // actual time spent

  @@index([profileId])
  @@index([contentId])
  @@index([startedAt])
  @@map("wellness_activities")
}

// Scored recommendation record (deterministic V1 scoring engine output).
model WellnessRecommendation {
  id         String              @id @default(uuid())
  profileId  String
  profile    MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentId  String
  content    WellnessContent     @relation(fields: [contentId], references: [id])
  score      Float               // deterministic score
  reason     String?             // e.g. 'mood_match:stressed,intent:stress_support'
  shownAt    DateTime            @default(now())
  clickedAt  DateTime?

  @@index([profileId])
  @@index([shownAt])
  @@map("wellness_recommendations")
}

// User enrollment in a multi-day wellness program.
model WellnessProgramEnrollment {
  id          String              @id @default(uuid())
  profileId   String
  profile     MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  programId   String
  program     WellnessProgram     @relation(fields: [programId], references: [id])
  startedAt   DateTime            @default(now())
  currentDay  Int                 @default(1)
  streakDays  Int                 @default(0)
  completedAt DateTime?
  isActive    Boolean             @default(true)

  @@index([profileId])
  @@map("wellness_program_enrollments")
}

// Gratitude / journal entry.
model GratitudeEntry {
  id        String              @id @default(uuid())
  profileId String
  profile   MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   String
  mood      WellnessEmotionType?
  createdAt DateTime            @default(now())

  @@index([profileId])
  @@map("gratitude_entries")
}

// Phase 4 stub: bridge to Healthcare+ professional appointment pipeline.
// Wires to existing Appointment model rather than duplicating booking logic.
model ProfessionalConnection {
  id            String              @id @default(uuid())
  profileId     String
  profile       MentalHealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  doctorId      String              // references Doctor.id
  appointmentId String?             // references Appointment.id once booked
  notes         String?
  createdAt     DateTime            @default(now())

  @@index([profileId])
  @@map("professional_connections")
}
